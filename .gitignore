# Environment and secrets
.env
.env.local
*.key
*.pem

# Docker overrides
docker-compose.override.yml

# Data and caches
data/
*.log
logs/

# Model files (too large for git)
models/
*.bin
*.safetensors
*.gguf

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Monitoring data
prometheus_data/
grafana_data/

# Temporary files
*.tmp
*.swp
*.swo
*~
.DS_Store

# IDE
.vscode/
.idea/
*.iml

# Backup files
*.backup
*.bak

# Build stamp: a hash of the local build context, written by `make build` so
# `make setup` is idempotent instead of rebuilding on every run. Per-host
# state, like .env — committing it would make one machine's build history
# decide whether another machine rebuilds.
.docker-build-hash
