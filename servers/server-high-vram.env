# High VRAM Server Profile
# For single GPU servers with 48GB+ VRAM (like RTX 6000, A100, H100)

SERVER_PROFILE=high-vram
GPU_DEVICES=0
# Set this to the box's ACTUAL VRAM. It read 96 on a profile whose own header
# documents it for "48GB+" cards (RTX 6000 Ada, A100 40/80, L40S) — and the
# A6000 box that was using it measures 48. GPU_VRAM_TOTAL is capacity-planning
# metadata, so a wrong value misleads sizing decisions without erroring.
# Purpose-built profiles now exist for the two real boxes:
#   servers/server-a6000-48gb.env       (A6000, 48 GB, sm_86)
#   servers/server-blackwell-97gb.env   (RTX PRO 6000 Blackwell, 97 GB, sm_120)
GPU_VRAM_TOTAL=48

# Run Ollama with large models
ENABLE_OLLAMA=true
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_PRELOAD_MODELS="qwen2.5:7b qwen3.6:latest gemma3:12b"

# Run vLLM with large model and aggressive settings
ENABLE_VLLM=true
VLLM_PORT=8000
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_MODEL_NAME=qwen3.6-35b
VLLM_GPU_MEMORY_UTILIZATION=0.65
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=64
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3"

# Enable embeddings service
ENABLE_EMBEDDINGS=true
EMBEDDINGS_PORT=8082
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_MAX_BATCH_TOKENS=16384

# Standard monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
