# Blackwell 97GB Profile
# RTX PRO 6000 Blackwell Max-Q — sm_120, 97 GB VRAM
#
# THE DEEP / LONG-CONTEXT / VISION BOX. llama.cpp serves Qwen3.8-Flash-Next
# behind gpu/chat/interactive and gpu/chat/vision.
#
# It deliberately does NOT serve gpu/chat/bulk or gpu/chat/fast. Flash-Next is
# effectively single-slot at this size, and `fast` carries a 60s timeout, so
# those two roles point at the A6000 box instead (see the block below). That
# is what the contract's server-addressed indirection is for: consumers pick a
# capability tier, and roles can live on different boxes without either side
# editing YAML.
#
# ┌─ BOTH ENGINES SHIP DISABLED ──────────────────────────────────────────┐
# │ Enable exactly ONE. scripts/deploy.sh exits non-zero if both are on.  │
# └───────────────────────────────────────────────────────────────────────┘
#
# BEFORE FIRST USE, verify the pinned image actually runs on sm_120:
#   docker run --rm --entrypoint sh $LLAMACPP_IMAGE -c '/app/llama-server --version'
# A too-old CUDA build does not degrade gracefully — every request dies with
# "no kernel image is available for execution on the device". This is the same
# trap the VLLM_IMAGE comment in docker-compose.yml documents.
#
# Also NOT yet verified on this box: the healthcheck binaries. b10884 ships
# curl; confirm b10644 does too before trusting the container health signal:
#   docker run --rm --entrypoint sh $LLAMACPP_IMAGE -c 'command -v curl'

SERVER_PROFILE=blackwell-97gb
GPU_DEVICES=0
GPU_VRAM_TOTAL=97

LITELLM_PORT=8080
# Set to this box's Netbird or LAN address. Check for a port-8080 conflict
# first (`ss -lntp | grep 8080`) — the A6000 box has one.
# LITELLM_BIND_ADDR=

# ── Engines: enable exactly one ───────────────────────────────────────────
ENABLE_VLLM=false
ENABLE_LLAMACPP=false

# ── llama.cpp: Qwen3.8-Flash-Next ─────────────────────────────────────────
# PINNED TO b10644, OVERRIDING the compose default of b10884.
#
# ggml-org/llama.cpp#28355 (OPEN, filed 2026-09-04) reports the 51B PLE
# n-gram embedding table failing to load on builds newer than 10665, causing
# extremely slow prefill. b10644 is the newest PUBLISHED build at or below
# 10665 — the registry has images for only 521 of the server-cuda-b* builds,
# and b10665 itself is not one of them. b10666 is skipped deliberately: it is
# one build past the last known-good number, so it may be the regression.
#
# This pin may prove unnecessary. If #28355's slow prefill is really
# LAZY_MODE=auto streaming the table off disk, then LAZY_MODE=off below fixes
# it on any build and this can move to b10884. That is a HYPOTHESIS from
# reading the flag semantics against the bug's symptom, not a verified claim —
# it needs a prefill measurement on this box first. Until then, stay pinned.
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10644
LLAMACPP_PORT=8083
LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00003.gguf
LLAMACPP_MODEL_NAME=qwen38-flash-next

# ONE slot at 128k, which still clears the >=32k contract floor for
# `interactive`. 76.3 GiB of weights on a 97 GB card leaves ~20 GB for KV,
# and that is ample: QSA runs a 2048-token budget, and only 12 of 48 layers
# grow KV at all — the other 36 are Gated DeltaNet with constant state.
LLAMACPP_CTX_SIZE=131072
LLAMACPP_PARALLEL=1
# Health-check FLOOR only; not passed to llama-server (see .env.example).
LLAMACPP_CTX_PER_SLOT=32768
LLAMACPP_FIT_CTX=131072

# `off` keeps the 51B PLE table resident in host memory rather than streamed
# from disk. This is the opposite of what lna-lab/flash-next-8gb does — that
# recipe streams it off NVMe at ~2.7 KB/token, which is a technique for an
# 8 GB card, not a 97 GB one with host RAM to spare.
LLAMACPP_LAZY_MODE=off
LLAMACPP_LOAD_MODE=mmap

LLAMACPP_FIT=on
LLAMACPP_FIT_TARGET=2048
LLAMACPP_NCMOE=
LLAMACPP_NGL=

LLAMACPP_FLASH_ATTN=on
# f16, NOT q8_0: PR #27742 reports -ctk/-ctv q8_0 assertion failures on the
# qwen4exp arch specifically. Reports conflict — a working 4090 config uses
# q8_0 — so treat it as a measured optimisation, never a default.
LLAMACPP_CACHE_TYPE_K=f16
LLAMACPP_CACHE_TYPE_V=f16

LLAMACPP_THREADS=16
LLAMACPP_CACHE_REUSE=256
LLAMACPP_REASONING=auto
# 30 min: 76 GiB of weights is a long first load.
LLAMACPP_START_PERIOD=1800s

# The 51B PLE table goes to HOST MEMORY — not the GPU, not disk.
LLAMACPP_OVERRIDE_TENSOR=per_layer_token_embd=CPU
# Flash-Next's vision tower (stock Qwen3-VL ViT). Download alongside the
# weights; adds roughly 900 MB of VRAM.
LLAMACPP_MMPROJ=/models/mmproj-F16.gguf

# ── Contract roles served HERE ────────────────────────────────────────────
CONTRACT_INTERACTIVE_MODEL=openai/qwen38-flash-next
CONTRACT_INTERACTIVE_API_BASE=http://llamacpp:8080/v1
# Vision on the chat model itself, rather than Ollama. Two wins: it is a far
# stronger VL model than gemma3:12b, and it avoids LiteLLM's Pillow
# dependency entirely — that is needed only for the Ollama path, since
# LiteLLM base64s images itself for OpenAI-compatible backends.
CONTRACT_VISION_MODEL=openai/qwen38-flash-next
CONTRACT_VISION_API_BASE=http://llamacpp:8080/v1

# ── Contract roles NOT served here ────────────────────────────────────────
# bulk and fast belong on the A6000 box. Point them at that box's LiteLLM
# ROOT on port 8080 — NOT at its llama.cpp on 8083, and with no path beyond
# what is shown here.
#
# Until these are uncommented this box is OFF-CONTRACT for both roles, and
# scripts/health-check.sh will say so. That is the intended loud failure: a
# consumer checks /v1/models at boot and refuses to start on a missing
# required role, which is far better than a silent half-service.
# CONTRACT_BULK_MODEL=openai/qwen3-next-80b
# CONTRACT_BULK_API_BASE=http://100.117.227.40:8080/v1
# CONTRACT_FAST_MODEL=openai/qwen3-next-80b
# CONTRACT_FAST_API_BASE=http://100.117.227.40:8080/v1

# ── Retrieval plane ───────────────────────────────────────────────────────
ENABLE_INFINITY=true
INFINITY_PORT=7997
CONTRACT_EMBED_API_BASE=http://infinity:7997
CONTRACT_RERANK_API_BASE=http://infinity:7997
ENABLE_EMBEDDINGS=false

# Vision is served by llama.cpp above, so Ollama has no role on this box.
ENABLE_OLLAMA=false

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
