# crimson-llm2  —  100.117.227.85
# RTX PRO 6000 Blackwell, 97 GB, sm_120
#
# THE BIG BOX. The only machine in the fleet with room for MORE THAN ONE chat
# model at once, so it is the one that uses vllm2/vllm3. Activate with
# SERVER_PROFILE=85.
#
# Measured against ddai3 on 2026-09-10 through ember's ingest pipeline: 1.55x
# faster on KG extraction overall and 2.0x on long documents, because that job
# fans out ~23 concurrent chunk requests per document and concurrency is bought
# with KV cache. It was SLOWER on single-request work (0.655s vs 0.445s median
# structured extraction) — that gap is the network hop, not the GPU. Place bulk
# extraction here and latency-sensitive turns on the box nearest the consumer.
#
# ⚠️  VRAM IS THIS FILE'S RESPONSIBILITY. vLLM PREALLOCATES its share, and each
# instance's utilization is a fraction of the WHOLE card, not of what is left.
# The three numbers below sum to 0.86, leaving ~13 GB for Infinity and headroom.
# Raise any of them and the next instance to start simply fails.

SERVER_NAME=crimson-llm2
GPU_DEVICES=0
GPU_VRAM_TOTAL=97

# ── Services this box runs ───────────────────────────────────────────────
ENABLE_VLLM=true
ENABLE_VLLM2=true
ENABLE_VLLM3=false          # room exists; enable when a third model is chosen
ENABLE_LLAMACPP=false
ENABLE_INFINITY=true
ENABLE_EMBEDDINGS=false
ENABLE_OLLAMA=false

VLLM_IMAGE=vllm/vllm-openai:v0.25.1

# ── Instance 1 → gpu/chat/interactive + gpu/chat/fast ────────────────────
# The latency-facing pair. A thinking model is the wrong default for `fast`,
# so this instance runs with reasoning OFF; instance 2 keeps it on.
VLLM_PORT=8000
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_MODEL_NAME=qwen3.6-fast
VLLM_GPU_MEMORY_UTILIZATION=0.42
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=64
VLLM_TOOL_CALL_PARSER=qwen3_xml
VLLM_REASONING_PARSER=
VLLM_EXPERT_PARALLEL=1

# ── Instance 2 → gpu/chat/bulk ───────────────────────────────────────────
# Throughput tier: more sequences, reasoning left ON because extraction quality
# benefits and a slow answer is still the right answer for bulk work.
VLLM2_PORT=8010
VLLM2_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM2_MODEL_NAME=qwen3.6-bulk
VLLM2_GPU_MEMORY_UTILIZATION=0.44
VLLM2_MAX_MODEL_LEN=32768
VLLM2_MAX_NUM_SEQS=96
VLLM2_TOOL_CALL_PARSER=qwen3_xml
VLLM2_REASONING_PARSER=qwen3
VLLM2_EXPERT_PARALLEL=1

# Instance 3 — unused for now. Left declared so enabling it is one flag, and
# so the port is reserved rather than rediscovered later.
VLLM3_PORT=8011
VLLM3_GPU_MEMORY_UTILIZATION=0.00

# ── Role → instance wiring ───────────────────────────────────────────────
# This is the point of running two: bulk lands on its own instance so a long
# extraction cannot queue behind an interactive turn. Instance hostnames are
# compose service names, resolved on the stack's internal network.
CONTRACT_INTERACTIVE_MODEL=openai/qwen3.6-fast
CONTRACT_INTERACTIVE_API_BASE=http://vllm:8000/v1
CONTRACT_FAST_MODEL=openai/qwen3.6-fast
CONTRACT_FAST_API_BASE=http://vllm:8000/v1
CONTRACT_BULK_MODEL=openai/qwen3.6-bulk
CONTRACT_BULK_API_BASE=http://vllm2:8000/v1

# ── Embed + rerank ───────────────────────────────────────────────────────
# NOT the TEI `embeddings` service. On 2026-09-10 this box's :8082 was running
# BAAI/bge-reranker-v2-m3 while its LiteLLM published it as `bge-m3-native`,
# so every embedding call failed ("Model is not an embedding model") and no
# consumer could embed against it at all. Infinity serves both models
# correctly from one container.
INFINITY_PORT=7997
INFINITY_CMD="v2 --model-id BAAI/bge-m3 --model-id BAAI/bge-reranker-v2-m3 --port 7997"

# ── Vision ───────────────────────────────────────────────────────────────
# Qwen3.6 is text-only. This box has the VRAM for a VL model but none is
# chosen yet, so the role stays unserved rather than published-and-broken.
CONTRACT_VISION_ALIAS=unserved/vision
CONTRACT_UNSERVED_ROLES="vision"

# ── Gateway ──────────────────────────────────────────────────────────────
# Bound to the Netbird address: every other box in the fleet is a consumer of
# this one, so loopback would make it unreachable where it matters.
LITELLM_PORT=8080
LITELLM_BIND_ADDR=100.117.227.85
LITELLM_REQUEST_TIMEOUT=900

LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=unused-on-this-box.gguf
