# crimson-llm2  —  100.117.227.85
# RTX PRO 6000 Blackwell, 97 GB, sm_120 · driver 570.133.07, CUDA 12.8
#
# Activate with SERVER_PROFILE=85.
#
# THIS PROFILE REPRODUCES WHAT THE BOX ALREADY SERVES, argument for argument,
# from a live inspection on 2026-09-11. It is a migration target, not a
# redesign: the vLLM container it starts is the same image, model and flags as
# the one running today, so consumers see no change.
#
# ONE chat instance, not two. An earlier draft of this file split the card
# between two 35B instances; the inspection killed that idea — the single
# instance already holds 62.8 GB at utilization 0.65, and the card is 88% used
# (86/97 GB) once cruxint's TEI workers, its PaddleOCR VLM and a second
# EngineCore are counted. There is no room for a second 35B.
#
# WHAT ELSE LIVES ON THIS GPU — do not disturb it. The cruxint OSINT backend
# runs its own containers here: cruxint-backend-tei-1 (bge-m3, host :8081),
# cruxint-backend-tei-rerank-1 (bge-reranker-v2-m3, host :8082) and
# cruxint-backend-ocr_vl-1 (PaddleOCR-VL, :8118). Their text-embeddings-router
# processes show `--port 8080` in `ps`, which is the CONTAINER-internal port —
# they are NOT competing for host :8080, and killing those PIDs breaks cruxint.
# Host :8080 is the LiteLLM gateway, which is this stack's own.

SERVER_NAME=crimson-llm2
GPU_DEVICES=0
GPU_VRAM_TOTAL=97

# ── Services ─────────────────────────────────────────────────────────────
ENABLE_VLLM=true
ENABLE_VLLM2=false          # no VRAM for a second 35B — see the header
ENABLE_VLLM3=false
ENABLE_LLAMACPP=false
ENABLE_OLLAMA=true          # 20 models; four legacy aliases resolve to it
ENABLE_INFINITY=false       # OFF by choice — see the embed/rerank note below
ENABLE_EMBEDDINGS=false     # would collide with cruxint's TEI on 8081/8082

# ── Chat: one vLLM instance, all three roles ─────────────────────────────
# v0.29.0 (2026-09-09), up from the v0.23.0 this box ran. Verified on ddai3
# before being set here, which is the only reason it is not a guess: the image
# boots, all three chat roles answer, TOOL CALLING parses, xgrammar structured
# output returns valid JSON, embeddings work, and the twelve "Unknown vLLM
# environment variable" warnings are gone.
#
# The two values most likely to break across six versions were checked in the
# 0.29.0 source rather than assumed — both are still registered:
#   qwen3_xml  tool parser       vllm/tool_parsers/__init__.py:181
#   qwen3      reasoning parser  vllm/reasoning/__init__.py:131
# (the runtime registries are lazily populated, so they read empty until used —
# do not conclude from an empty registry that a parser is gone.)
#
# NOT covered by that test: this box serves FP8 WEIGHTS (Qwen3.6-35B-A3B-FP8)
# while ddai3 serves AWQ 4-bit, so the FP8 weight-loading path on 0.29 is
# unexercised. It is a standard path, but if this box fails to start, that is
# the first thing to suspect — and the fallback is one line: v0.23.0.
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
# Host 11502, because the legacy alias qwen3.6-vllm-direct resolves to
# host.docker.internal:11502. Changing it breaks that alias.
VLLM_PORT=11502
VLLM_ROUTER_PORT=11500      # qwen3.6-vllm-router resolves here
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# `qwen3.6` verbatim: 260 of the last 290 gateway requests were openai/qwen3.6.
# Renaming it is the single most breaking change available here.
VLLM_MODEL_NAME=qwen3.6
VLLM_GPU_MEMORY_UTILIZATION=0.65    # observed 62.8 GB resident
# 32768 — RAISED from the 16384 the box serves today, to meet the floor the
# contract's interactive and bulk roles promise. This is the one deliberate
# behaviour change in this profile.
#
# It does NOT increase VRAM: vLLM sizes its KV pool from gpu-memory-utilization
# (0.65 -> 62.8 GB observed), and max-model-len only caps how long a single
# sequence may be. What it costs is CONCURRENCY AT FULL LENGTH — the same pool
# now holds half as many 32k sequences as 16k ones. max-num-seqs stays 62
# because that is a ceiling, not a reservation; real concurrency is whatever
# the pool allows.
#
# vLLM refuses to start if the pool cannot hold even one sequence of this
# length. If it does, lower this or raise utilization — do not force it with
# VLLM_ALLOW_LONG_MAX_MODEL_LEN, which disables the very check that protects
# you here.
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=62
VLLM_TENSOR_PARALLEL_SIZE=1
# FP8 KV cache. Measured on ddai3 (same sm_120 generation): 83,520 -> 173,856
# tokens on 0.25.1, and 162,576 at 4.96x concurrency on 0.29.0 — roughly double
# the fp16 baseline either way. It changes NOTHING a consumer can see: same
# model name, same endpoints, same response shape. Outputs are not bit-identical
# to fp16 KV, so anything doing exact-match caching or golden-output comparison
# will see differences; quality is unaffected, and the perturbation is far below
# that of the FP8 weights this box already serves.
#
# It also pays for the context raise above: 16384 -> 32768 halves concurrency at
# full length, and this roughly doubles it back.
VLLM_KV_CACHE_DTYPE=fp8
VLLM_TOOL_CALL_PARSER=qwen3_xml
# KEPT ON — unlike the 32 GB boxes. Qwen3.6 here is a THINKING model and this
# is its current behaviour; consumers already disable thinking per request with
# chat_template_kwargs {"enable_thinking": false} when they want plain content.
# Removing the parser would change every existing response shape.
VLLM_REASONING_PARSER=qwen3
# Qwen3.6-35B-A3B IS mixture-of-experts — A3B means 3B active parameters — so
# expert parallel belongs on. (The inspection report's note that this "is NOT
# an MoE model" is mistaken.)
VLLM_EXPERT_PARALLEL=1

# ── Ollama ───────────────────────────────────────────────────────────────
# 11437 preserves qwen2.5-7b-ollama-native, qwen3.6-ollama-native,
# gemma3-12b-ollama-native and granite3.3-8b-ollama-native.
OLLAMA_PORT=11437

# ── Embed + rerank: UNSERVED on this box ─────────────────────────────────
# Infinity is off, so this stack serves no embedder or reranker. The card is
# 88% used (86/97 GB) by the 35B model, cruxint's TEI workers, its PaddleOCR
# VLM and a second EngineCore; ~3.5 GB for models cruxint already holds is not
# worth spending here.
#
# The roles are therefore published OUTSIDE the gpu/ namespace rather than left
# pointing at nothing. An alias that exists and fails on every call is worse
# than an absent one: a consumer's boot check passes and the failure only
# appears in production. Unserved, consumers fall back cleanly — ember routes
# embedding to whichever stack its PROFILE_EMBEDDING names, e.g. the .63 box.
CONTRACT_EMBED_ALIAS=unserved/embed
CONTRACT_RERANK_ALIAS=unserved/rerank
#
# Note the legacy aliases are UNAFFECTED and still work: bge-m3-native and
# bge-reranker-v2-m3-native resolve to cruxint's TEI on host 8081 / 8082.
# Anything already embedding against this box keeps doing so.
#
# To serve the contract roles here instead, set ENABLE_INFINITY=true, drop the
# two alias lines above, and budget ~3.5 GB:
# INFINITY_PORT=7997
# INFINITY_CMD="v2 --model-id BAAI/bge-m3 --model-id BAAI/bge-reranker-v2-m3 --port 7997"

# ── Vision: UNSERVED ─────────────────────────────────────────────────────
# Qwen3.6 is text-only. The card has headroom for a VL model but none is
# chosen, so the role stays unserved rather than published-and-broken.
CONTRACT_VISION_ALIAS=unserved/vision
# Chat roles only — embed/rerank are declared unserved via their aliases.
CONTRACT_UNSERVED_ROLES="vision"

# ── Gateway ──────────────────────────────────────────────────────────────
# 8080 is where the current LiteLLM already listens, and where every consumer
# points. Bound to the Netbird address: the rest of the fleet consumes this box.
LITELLM_PORT=8080
LITELLM_BIND_ADDR=100.117.227.85
LITELLM_REQUEST_TIMEOUT=900

LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=unused-on-this-box.gguf
