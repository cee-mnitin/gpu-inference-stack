# ddai5  —  100.117.227.72
# RTX PRO 4500 Blackwell, 32.6 GB, sm_120
#
# BULK / EXTRACTION BOX, identical hardware to ddai3. One vLLM instance fills
# all three chat roles; Infinity fills embed + rerank; vision is unserved.
# Activate with SERVER_PROFILE=72.
#
# Deliberately a near-copy of server-63.env: same card, same model, same
# reasoning-parser caveat. The differences are the two that are genuinely
# per-host — SERVER_NAME and LITELLM_PORT (8080 is free here; ddai3 must use
# 8090 because the shared platform's traefik holds 8080 there). Keeping the
# rest byte-identical means `diff servers/server-63.env servers/server-72.env`
# shows exactly what is host-specific and nothing else.
#
# ONE chat instance, not three. 26 GB of the card is the AWQ model plus its KV
# cache and ~4 GB is Infinity; there is no room for a second. Delegate instead
# of splitting — see the commented block at the bottom.

SERVER_NAME=ddai5
GPU_DEVICES=0
GPU_VRAM_TOTAL=32

# ── Services this box runs ───────────────────────────────────────────────
ENABLE_VLLM=true
ENABLE_VLLM2=false
ENABLE_VLLM3=false
ENABLE_LLAMACPP=false
ENABLE_INFINITY=true
ENABLE_EMBEDDINGS=false     # TEI has no sm_120 build — see below
ENABLE_OLLAMA=false

# ── Chat instance 1 → all three chat roles ───────────────────────────────
# v0.23.0 (the compose default) predates sm_120 and does not degrade
# gracefully. Verify any bump starts on this card before rolling it out.
VLLM_IMAGE=vllm/vllm-openai:v0.25.1
VLLM_PORT=8000
VLLM_MODEL=cyankiwi/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
VLLM_MODEL_NAME=qwen3-30b-a3b
# 0.80 x 32.6 GB ~ 26 GB, leaving ~6 GB for Infinity's two 568M models.
# Do NOT lower toward the 0.65 default: KG extraction fans out ~23 concurrent
# chunk requests, so KV cache is the throughput limit for that workload. At
# 0.72 the cache thrashed at 99% with 18 queued and a 17k-char document took
# 875s; at 0.86 the queue stayed empty and the corpus ran ~2x faster.
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=32
VLLM_TOOL_CALL_PARSER=hermes
# EMPTY ON PURPOSE — Instruct-2507 is the NON-thinking variant. Under
# --reasoning-parser qwen3 it returned content:null with the answer in
# reasoning_content on 5/5 calls, because no closing </think> ever arrives.
# Empty omits the flag entirely.
VLLM_REASONING_PARSER=
VLLM_EXPERT_PARALLEL=1

# ── Embed + rerank ───────────────────────────────────────────────────────
# Infinity, NOT TEI: text-embeddings-inference publishes turing / 89 / hopper
# / latest and nothing for sm_120, and crash-loops here with "Runtime compute
# cap 120 is not compatible with compile time compute cap 80". Infinity's
# torch engine runs fine and serves both models from one container —
# 346-3475 embeddings/sec at batch 32 on this card.
INFINITY_PORT=7997
INFINITY_CMD="v2 --model-id BAAI/bge-m3 --model-id BAAI/bge-reranker-v2-m3 --port 7997"

# ── Vision: UNSERVED ─────────────────────────────────────────────────────
# Text-only model and no spare VRAM. Publishing gpu/chat/vision behind a text
# model would pass a consumer's boot check and then fail on the first image,
# so the deployment is named outside the contract namespace and consumers fall
# back cleanly.
CONTRACT_VISION_ALIAS=unserved/vision
CONTRACT_UNSERVED_ROLES="vision"

# ── Gateway ──────────────────────────────────────────────────────────────
# 8080 is free on this host, unlike ddai3 where platform-traefik holds it.
# The other shifts below are kept identical to ddai3 so the two Blackwell
# boxes stay diffable; drop them if this host runs no shared platform.
LITELLM_PORT=8080
LITELLM_BIND_ADDR=0.0.0.0
LITELLM_REQUEST_TIMEOUT=900
REDIS_PORT=6380
PROMETHEUS_PORT=9490
GRAFANA_PORT=3400
NGINX_PORT=8081
NGINX_HTTPS_PORT=8443

# Required even with ENABLE_LLAMACPP=false: compose interpolates every
# service's environment before profiles apply, so an unset required variable
# refuses to render the file for a service that will never start.
LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=unused-on-this-box.gguf

# ── Delegating a role to a peer (uncomment to use) ───────────────────────
# Addresses come from the GPU_<octet>_* block in .env, which is identical on
# every box, so nothing here repeats an IP. The /v1 suffix is required for
# chat and vision bases; embed/rerank bases must NOT have it.
#
# CONTRACT_BULK_API_BASE=${GPU_85_URL}/v1
# CONTRACT_BULK_MODEL=openai/qwen3.6
# CONTRACT_BULK_API_KEY=${GPU_85_KEY}
#
# CONTRACT_VISION_ALIAS=gpu/chat/vision
# CONTRACT_VISION_API_BASE=${GPU_85_URL}/v1
# CONTRACT_VISION_MODEL=openai/qwen3.6
# CONTRACT_VISION_API_KEY=${GPU_85_KEY}
