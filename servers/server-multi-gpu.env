# Multi-GPU Server Profile
# For servers with 2+ GPUs

SERVER_PROFILE=multi-gpu
GPU_DEVICES=0,1
GPU_VRAM_TOTAL=192  # 2x 96GB

# Run Ollama on GPU 0
ENABLE_OLLAMA=true
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_PRELOAD_MODELS="qwen2.5:7b qwen3.6:latest gemma3:12b granite3.3:8b"

# Run vLLM with tensor parallelism across GPUs
ENABLE_VLLM=true
VLLM_PORT=8000
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_MODEL_NAME=qwen3.6-35b
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=128
VLLM_TENSOR_PARALLEL_SIZE=2  # Use both GPUs
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3 --enable-expert-parallel"

# Run embeddings on GPU 0
ENABLE_EMBEDDINGS=true
EMBEDDINGS_PORT=8082
EMBEDDINGS_MODEL=BAAI/bge-m3

# Standard monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000


# ── Consumer contract: BIND THESE BEFORE DEPLOYING ────────────────────────
# This is a multi-GPU box starting point and it binds NO contract role, so
# gpu/chat/{interactive,bulk,fast} would be published pointing at nothing —
# LiteLLM lists them in /v1/models and every request 500s. scripts/deploy.sh
# refuses to start in that state.
#
# Set the weights each role should serve (one model may serve several; see
# server-a6000-48gb.env, which points all three chat roles at the same
# weights), and declare any role this box will not serve:
#
#   CONTRACT_INTERACTIVE_MODEL=openai/<your-model>
#   CONTRACT_INTERACTIVE_API_BASE=http://vllm:8000/v1
#   CONTRACT_BULK_MODEL=openai/<your-model>
#   CONTRACT_BULK_API_BASE=http://vllm:8000/v1
#   CONTRACT_FAST_MODEL=openai/<your-model>
#   CONTRACT_FAST_API_BASE=http://vllm:8000/v1
#   CONTRACT_EMBED_API_BASE=http://infinity:7997
#   CONTRACT_RERANK_API_BASE=http://infinity:7997
#   CONTRACT_UNSERVED_ROLES=""          # e.g. "bulk fast"
#
# The MODEL name is this box's business; the ROLE name is the contract. That
# split is what lets one consumer preset move between boxes of different size
# without either side editing YAML.
