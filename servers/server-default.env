# Default Server Profile
# For single GPU servers with ~8-24GB VRAM

SERVER_PROFILE=default
GPU_DEVICES=0
GPU_VRAM_TOTAL=24

# Run Ollama with small-medium models
ENABLE_OLLAMA=true
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_PRELOAD_MODELS="qwen2.5:7b"

# Run one vLLM instance with moderate settings
ENABLE_VLLM=true
VLLM_PORT=8000
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_MODEL_NAME=qwen2.5-7b-vllm
VLLM_GPU_MEMORY_UTILIZATION=0.50
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=32
VLLM_TENSOR_PARALLEL_SIZE=1

# Disable embeddings to save VRAM
ENABLE_EMBEDDINGS=false

# Standard monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
