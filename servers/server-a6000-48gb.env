# A6000 48GB Profile
# RTX A6000 — sm_86 (Ampere), 48 GB VRAM, 251 GB RAM, rotational SAS (no NVMe)
#
# THE CONTRACT BOX. llama.cpp serves Qwen3-Next-80B-A3B behind all three
# REQUIRED gpu/chat/* roles. vLLM is off here: 33.19 GiB of weights plus
# vLLM's ~31 GB does not fit in 48 GB.
#
# ┌─ BOTH ENGINES SHIP DISABLED ──────────────────────────────────────────┐
# │ Enable exactly ONE, deliberately:                                     │
# │   ENABLE_LLAMACPP=true   <- what this box is designed for             │
# │   ENABLE_VLLM=true       <- the previous Qwen3.6-35B-A3B-FP8 setup    │
# │ scripts/deploy.sh exits non-zero if both are true.                    │
# └───────────────────────────────────────────────────────────────────────┘
#
# Why llama.cpp and not vLLM on this box: sm_86 predates FP8/FP4 tensor
# cores, so the FP8 and NVFP4 quants modern vLLM recipes assume have no
# native kernel path here. GGUF + llama.cpp's mature CPU-offload does.
#
# Prerequisite: weights must be downloaded first. See docs/LLAMACPP.md.

SERVER_PROFILE=a6000-48gb
GPU_DEVICES=0
GPU_VRAM_TOTAL=48

# ── LiteLLM bind address: REQUIRED on this box ────────────────────────────
# platform-traefik already holds 127.0.0.1:8080, and LiteLLM's compose
# default binds 0.0.0.0:8080 — which covers loopback, so the bind fails and
# the gateway never starts. Pin it to a specific interface:
#   wt0     100.117.227.40   (Netbird — how consumers reach this box)
#   ens10f0 192.168.3.40     (LAN alternative)
# Ports 80 and 443 are also held by traefik, so the optional nginx profile
# cannot be enabled here.
LITELLM_BIND_ADDR=100.117.227.40
LITELLM_PORT=8080

# ── Engines: enable exactly one ───────────────────────────────────────────
ENABLE_VLLM=false
ENABLE_LLAMACPP=false

# ── llama.cpp: Qwen3-Next-80B-A3B ─────────────────────────────────────────
# UD-Q3_K_XL (33.19 GiB) is chosen for RESIDENCY, not for maximum fidelity.
# Measured budget on this card (48086 MiB = 46.96 GiB free of 47.99 total):
#
#     46.96  free
#    - 3.00  Infinity (bge-m3 + bge-reranker-v2-m3)
#    - 3.00  KV cache @ 131072 ctx, f16
#            (only 12 of 48 layers are full-attention: 2 KV heads x 256 dim
#             x 2 (K+V) x 2 B = 24.6 KB/token. The other 36 are Gated
#             DeltaNet with constant state — which is why 128k is cheap.)
#    - 2.50  graph / compute buffers + CUDA context
#    - 1.50  safety margin
#    -------
#     36.96  available for weights   ->  33.19 fits with ~3.7 GiB spare
#
# IQ4_XS (39.72 GiB) is the quality-first alternative: `fit on` will offload
# the ~3 GiB of overflow to CPU with no other change. Swap MODEL_FILE only.
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10884
LLAMACPP_PORT=8083
LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=Qwen3-Next-80B-A3B-Instruct-UD-Q3_K_XL.gguf
LLAMACPP_MODEL_NAME=qwen3-next-80b

# Context: 131072 / 4 slots = 32768 per slot = the contract floor EXACTLY.
# Raising PARALLEL without raising CTX_SIZE breaks the contract silently;
# scripts/health-check.sh asserts the live per-slot value for that reason.
LLAMACPP_CTX_SIZE=131072
LLAMACPP_PARALLEL=4
LLAMACPP_CTX_PER_SLOT=32768
LLAMACPP_FIT_CTX=131072

# MANDATORY `off` on this box. The upstream default `auto` reads the rows of
# any tensor over 4 GiB from disk on demand — and this box has NO NVMe, only
# a rotational SAS logical volume, so that is seek-bound. 251 GB of RAM makes
# full residency free.
LLAMACPP_LAZY_MODE=off
LLAMACPP_LOAD_MODE=mmap

# Empty NCMOE/NGL: let `fit` measure real free VRAM at boot and offload only
# what does not fit. This adapts when Infinity's footprint moves; a hardcoded
# -ncmoe goes stale and then fails closed with an OOM instead of degrading.
LLAMACPP_FIT=on
LLAMACPP_FIT_TARGET=2048
LLAMACPP_NCMOE=
LLAMACPP_NGL=

# f16 KV, not q8_0 — q8_0 asserts at load on the qwen4exp arch (PR #27742).
LLAMACPP_FLASH_ATTN=on
LLAMACPP_CACHE_TYPE_K=f16
LLAMACPP_CACHE_TYPE_V=f16

LLAMACPP_THREADS=16
LLAMACPP_CACHE_REUSE=256
LLAMACPP_REASONING=auto
LLAMACPP_START_PERIOD=900s

# Empty: Qwen3-Next-80B-A3B has no PLE table and no vision tower.
LLAMACPP_OVERRIDE_TENSOR=
LLAMACPP_MMPROJ=

# ── Contract roles: all three chat roles on llama.cpp ─────────────────────
# 3B active parameters gives this model real concurrency, so unlike
# Flash-Next it can honestly fill `bulk` and `fast` as well as `interactive`.
CONTRACT_INTERACTIVE_MODEL=openai/qwen3-next-80b
CONTRACT_INTERACTIVE_API_BASE=http://llamacpp:8080/v1
CONTRACT_BULK_MODEL=openai/qwen3-next-80b
CONTRACT_BULK_API_BASE=http://llamacpp:8080/v1
CONTRACT_FAST_MODEL=openai/qwen3-next-80b
CONTRACT_FAST_API_BASE=http://llamacpp:8080/v1

# ── Retrieval plane: REQUIRED roles, stays on ─────────────────────────────
ENABLE_INFINITY=true
INFINITY_PORT=7997
CONTRACT_EMBED_API_BASE=http://infinity:7997
CONTRACT_RERANK_API_BASE=http://infinity:7997
ENABLE_EMBEDDINGS=false

# ── Vision: UNSERVED on this box, deliberately ────────────────────────────
# Qwen3-Next-80B-A3B is text-only, and the VRAM budget above has no room for
# Ollama's ~10 GiB VL model on top of a 33 GiB resident chat model.
#
# gpu/chat/vision is an OPTIONAL contract role: a consumer that cannot find
# it routes vision to a cloud provider, which is clean degradation. Pointing
# it at something that half-works is exactly what the contract rules forbid,
# so it is left unserved rather than under-resourced.
#
# To serve it anyway: ENABLE_OLLAMA=true plus CONTRACT_VISION_* — and expect
# `fit` to start offloading experts to CPU to make room, costing decode speed.
ENABLE_OLLAMA=false

# ENABLE_OLLAMA=false alone is NOT enough to unserve the role. LiteLLM
# publishes every alias in config.yaml whether or not its backend answers, so
# gpu/chat/vision would stay listed in /v1/models and every call would 500 with
# "Cannot connect to host ollama:11434" — worse than absent, because a consumer
# routes around a MISSING optional role but breaks on a published-but-dead one.
#
# Renaming the alias out of the gpu/ contract namespace unpublishes it properly.
# Consumers looking for gpu/chat/vision do not find it and fall back to their
# cloud provider, exactly as the contract intends.
CONTRACT_VISION_ALIAS=unserved/vision

# ── Monitoring ────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
