# Blackwell 32GB Profile
# RTX PRO 4500 Blackwell — sm_120, 32.6 GB VRAM  (ddai1–ddai5)
#
# THE BULK / EXTRACTION BOX. One MoE chat model fills all three chat roles,
# and Infinity fills embed + rerank. Vision is deliberately unserved: there is
# no VRAM for a second model, and a text model behind gpu/chat/vision passes a
# consumer's boot check and then fails on the first image.
#
# Measured on ddai3, 2026-09-10, against ember's ingest pipeline:
#   structured field extraction   0.445s median, 100% accuracy on 100 fields
#   summarization                 1.00s median
#   KG extraction (GraphPipeline) 39.5s median over 27 documents
#   embeddings (Infinity, bge-m3) 346–3475 emb/sec at batch 32
#
# ┌─ THREE THINGS THAT BITE ON THIS CARD ─────────────────────────────────┐
# │ 1. vLLM 0.23.0 predates sm_120. Pin 0.25.1 or newer.                  │
# │ 2. TEI has NO Blackwell build. Use Infinity (it also gives rerank).   │
# │ 3. A non-thinking model under --reasoning-parser returns content:null.│
# └───────────────────────────────────────────────────────────────────────┘

SERVER_NAME=blackwell-32gb
SERVER_PROFILE=default
GPU_DEVICES=0
GPU_VRAM_TOTAL=32

# ── vLLM — fills all three chat roles ────────────────────────────────────
ENABLE_VLLM=true
ENABLE_LLAMACPP=false
VLLM_PORT=8000
# NOT the v0.23.0 default: 0.23 predates Blackwell (sm_120) support and does
# not degrade gracefully. Verify any bump actually starts on this card:
#   docker run --rm --gpus all $VLLM_IMAGE --help >/dev/null
VLLM_IMAGE=vllm/vllm-openai:v0.25.1
# Qwen3-30B-A3B-Instruct-2507, AWQ 4-bit — ~18 GB on disk, MoE with 3B active.
# The INSTRUCT (non-thinking) variant; see VLLM_REASONING_PARSER below.
VLLM_MODEL=cyankiwi/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
VLLM_MODEL_NAME=qwen3-30b-a3b
# 0.80 x 32.6 GB ~ 26 GB, leaving ~6 GB for Infinity's two 568M models.
#
# Do NOT tune this down toward the 0.65 default. KG extraction fans out ~23
# concurrent chunk requests per document, so KV cache — not model size — is
# the throughput limit for that workload. Measured on ddai3: at 0.72 the cache
# sat at 99% with 18 requests queued and a 17k-char document took 875s; at
# 0.86 the queue stayed empty and the same corpus ran ~2x faster than the
# first attempt. 0.80 is the compromise that still leaves Infinity its VRAM.
VLLM_GPU_MEMORY_UTILIZATION=0.80
# 32768 = the floor gpu/chat/{interactive,bulk} promise. Lower breaks the
# contract, not just this box.
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=32
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_TOOL_CALL_PARSER=hermes
# ⚠️  REASONING PARSER — read before serving a non-thinking model.
#
# The compose command always emits `--reasoning-parser
# ${VLLM_REASONING_PARSER:-qwen3}`; there is no value meaning "off". Under the
# qwen3 parser a NON-thinking model (this one) never emits a closing </think>,
# so vLLM treats the entire completion as unterminated reasoning and returns
#     content: null,  reasoning_content: "<the actual answer>"
# on EVERY call — 5/5 measured on ddai3, not intermittent. That breaks the
# gpu/chat/* contract silently: a consumer reads choices[0].message.content,
# gets nothing, and sees an empty answer rather than an error.
#
# Until the flag can be omitted, a box serving an Instruct model needs a
# docker-compose.override.yml that repeats the vllm command without the two
# --reasoning-parser lines. Swapping in a Thinking variant makes the default
# correct again.
VLLM_REASONING_PARSER=qwen3

# ── Infinity — fills gpu/embed/bge-m3 and gpu/rerank/bge-reranker-v2-m3 ──
# NOT TEI. text-embeddings-inference publishes turing / 89 / hopper / latest
# and nothing for sm_120; it crash-loops here with "Runtime compute cap 120 is
# not compatible with compile time compute cap 80". Infinity's torch engine
# runs on this card without complaint and serves both models from one
# container, which TEI on a single port could not.
ENABLE_INFINITY=true
INFINITY_PORT=7997
INFINITY_CMD="v2 --model-id BAAI/bge-m3 --model-id BAAI/bge-reranker-v2-m3 --port 7997"
INFINITY_QUEUE_SIZE=512

# ── Vision — UNSERVED ────────────────────────────────────────────────────
# Publishes the Ollama deployment outside the contract namespace so consumers
# do not find gpu/chat/vision and fall back cleanly (ember: PRESET with a
# cloud vision profile), while the entry stays introspectable for debugging.
CONTRACT_VISION_ALIAS=unserved/vision
ENABLE_OLLAMA=false

# Required even with ENABLE_LLAMACPP=false: compose interpolates every
# service's environment before profiles are applied, so an unset required
# variable refuses to render the file for a service that will never start.
LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=unused-on-this-box.gguf

# ── LiteLLM gateway ──────────────────────────────────────────────────────
# ⚠️  PORTS ARE REMAPPED off this stack's defaults, because these boxes also
# run the shared deepdarshak platform, which already holds 8080 (traefik
# dashboard), 6379 (falkordb), 9090 (prometheus) and 80/443 (traefik).
# Restoring the defaults on such a host makes the stack fail to bind.
LITELLM_PORT=8090
LITELLM_ADMIN_PORT=8091
LITELLM_BIND_ADDR=0.0.0.0
LITELLM_DROP_PARAMS=true
LITELLM_REQUEST_TIMEOUT=900
LITELLM_CACHE_TYPE=redis
LITELLM_REDIS_HOST=redis
LITELLM_REDIS_PORT=6379
# CHANGE THIS — placeholder.  openssl rand -hex 32
# Admin credential: it can read spend, mutate models and mint keys. Never hand
# it to a consumer; issue each one a virtual key scoped to the contract
# aliases (see the /key/generate recipe in .env.example).
LITELLM_MASTER_KEY=sk-CHANGE-ME

REDIS_PORT=6380
PROMETHEUS_PORT=9490
GRAFANA_PORT=3400
NGINX_PORT=8081
NGINX_HTTPS_PORT=8443

# ── Storage ──────────────────────────────────────────────────────────────
# Point HF_HOME at a cache shared with anything else on the box that pulls the
# same weights, so 18 GB of Qwen is downloaded once rather than per stack.
DATA_DIR=./data
VLLM_CACHE_DIR=${DATA_DIR}/vllm/cache
HF_HOME=${DATA_DIR}/huggingface

NETWORK_NAME=gpu-inference-net
LOG_LEVEL=INFO
