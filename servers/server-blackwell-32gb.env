# Blackwell 32GB Profile
# RTX PRO 4500 Blackwell — sm_120, 32.6 GB VRAM  (ddai1–ddai5)
#
# THE BULK / EXTRACTION BOX. One MoE chat model fills all three chat roles and
# now vision too, and Infinity fills embed + rerank.
#
# GENERIC TEMPLATE, not a live box. ddai1-ddai5 run servers/server-6{1,2,3,4}
# and server-72, which all inherit common-blackwell-32gb.env. This file is kept
# standalone because it documents the full key set for the card — including the
# LiteLLM cache and admin keys the shared base leaves at their defaults — so it
# is the thing to copy when bringing up a Blackwell 32GB box that is not a ddai
# machine. Keep its model settings in step with the base.
#
# Measured on ddai3, 2026-09-10, against ember's ingest pipeline:
#   structured field extraction   0.445s median, 100% accuracy on 100 fields
#   summarization                 1.00s median
#   KG extraction (GraphPipeline) 39.5s median over 27 documents
#   embeddings (Infinity, bge-m3) 346–3475 emb/sec at batch 32
#
# ┌─ THREE THINGS THAT BITE ON THIS CARD ─────────────────────────────────┐
# │ 1. Pin a vLLM build proven on this card, and >= 0.28.0 for NVFP4.     │
# │ 2. TEI has NO Blackwell build. Use Infinity (it also gives rerank).   │
# │ 3. Match the tool/reasoning parsers to the MODEL, not to the card.    │
# └───────────────────────────────────────────────────────────────────────┘

SERVER_NAME=blackwell-32gb
SERVER_PROFILE=default
GPU_DEVICES=0
GPU_VRAM_TOTAL=32

# ── vLLM — fills all three chat roles ────────────────────────────────────
ENABLE_VLLM=true
ENABLE_LLAMACPP=false
VLLM_PORT=8000
# v0.29.0. This is a FLOOR, not just a known-good pin: NVFP4 on sm_120 needs
# >= 0.28.0, below which FlashInfer does not select its XQA decode kernel here
# and silently falls back. The compose default v0.23.0 cannot serve this model.
#   docker run --rm --gpus all $VLLM_IMAGE --help >/dev/null
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
# Qwen3.6-35B-A3B in NVFP4 — 23.5 GB on disk, MoE with ~3B active, multimodal,
# Apache 2.0. Chosen over a dense model of similar quality because decode on
# this card is bandwidth-bound at 896 GB/s, so ACTIVE parameters set the token
# rate; and in NVFP4 rather than AWQ because sm_120 has native FP4 tensor cores
# and NVIDIA publishes the accuracy retained (MMLU-Pro 85.0 vs 85.6 BF16).
# The full argument, including why not the higher-scoring dense Qwen3.8-27B,
# is in servers/common-blackwell-32gb.env.
VLLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
VLLM_MODEL_NAME=qwen3.6-35b-a3b
# 0.80 x 32.6 GB ~ 26 GB, leaving ~6 GB for Infinity's two 568M models.
#
# Do NOT tune this down toward the 0.65 default. KG extraction fans out ~23
# concurrent chunk requests per document, so KV cache — not model size — is
# the throughput limit for that workload. Measured on ddai3: at 0.72 the cache
# sat at 99% with 18 requests queued and a 17k-char document took 875s; at
# 0.86 the queue stayed empty and the same corpus ran ~2x faster than the
# first attempt. 0.80 is the compromise that still leaves Infinity its VRAM.
#
# MEASURED AFTER THE MODEL CHANGE, 2026-09-12 on ddai4 — and the prediction
# that stood here was WRONG. The worry was that this checkpoint's larger
# weights (23.5 GB on disk vs the AWQ build's ~17 GiB) would take ~5 GiB out of
# the KV pool. They did not. At 0.84:
#     Available KV cache memory   2.93 GiB
#     GPU KV cache size           210,013 tokens
#     Maximum concurrency @32k    6.41x
# against 173,856 tokens / 5.31x recorded above for AWQ — 21% MORE KV, not
# less. The reason is architectural: Qwen3.6-35B-A3B is a hybrid Gated DeltaNet
# model, and its GDN layers carry a fixed-size recurrent state instead of a
# per-token KV cache. Only the true attention layers pay per token, so weight
# size is NOT a proxy for KV pressure here the way it was for a full-attention
# model. Weights and KV together sit at 29,907 MiB of 32,623 MiB with Infinity
# resident.
#
# vLLM notes at boot that CUDA-graph memory profiling makes 0.84 behave like
# 0.8152, and that 0.8648 would restore the pre-profiling effective KV size.
# Unnecessary while the pool is already ahead of the AWQ baseline; it is the
# lever if KG extraction ever queues again.
VLLM_GPU_MEMORY_UTILIZATION=0.80
# 32768 = the floor gpu/chat/{interactive,bulk} promise. Lower breaks the
# contract, not just this box.
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=32
VLLM_TENSOR_PARALLEL_SIZE=1
# qwen3_xml, not hermes: Qwen3.6's chat template emits
# `<tool_call><function=NAME><parameter=KEY>`, where hermes expects JSON inside
# <tool_call>. Mismatched, no tool call is ever parsed and the model looks like
# one that simply never calls tools.
VLLM_TOOL_CALL_PARSER=qwen3_xml
# SET, because the model is now hybrid-thinking. Read the history before
# changing it, because the failure it records is silent:
#
# This was EMPTY while the served model was Instruct-2507. A non-thinking model
# never emits a closing </think>, so vLLM treated the whole completion as
# unterminated reasoning and returned `content: null` with the answer in
# `reasoning_content` — 5/5 measured on ddai3, not intermittent. A consumer
# reading choices[0].message.content got an empty answer rather than an error.
# That file's instruction was "swap in a Thinking variant and set this back to
# qwen3"; Qwen3.6-35B-A3B is one, so it is set.
#
# The rule is that this tracks the MODEL. Point VLLM_MODEL back at any Instruct
# or other non-thinking build and this must go empty again.
VLLM_REASONING_PARSER=qwen3
# MoE model, so expert parallel stays on. Set empty for a dense model.
VLLM_EXPERT_PARALLEL=1
# REQUIRED FOR NVFP4 ON sm_120, per vLLM's recipe for this model:
# --quantization names the ModelOpt FP4 loader, --block-size 128 is what
# FlashInfer's TRT-LLM attention kernels need at this compute capability.
VLLM_EXTRA_ARGS="--quantization modelopt_fp4 --block-size 128"
# Lets vLLM read FlashInfer's precompiled cubins directly; without it the
# sm_120 XQA decode kernel is not selected and the fallback is a silent
# throughput loss rather than an error.
VLLM_HAS_FLASHINFER_CUBIN=1

# ── Infinity — fills gpu/embed/bge-m3 and gpu/rerank/bge-reranker-v2-m3 ──
# NOT TEI. text-embeddings-inference publishes turing / 89 / hopper / latest
# and nothing for sm_120; it crash-loops here with "Runtime compute cap 120 is
# not compatible with compile time compute cap 80". Infinity's torch engine
# runs on this card without complaint and serves both models from one
# container, which TEI on a single port could not.
ENABLE_INFINITY=true
INFINITY_PORT=7997
INFINITY_CMD="v2 --model-id BAAI/bge-m3 --model-id BAAI/bge-reranker-v2-m3 --port 7997"
INFINITY_QUEUE_SIZE=512

# ── Vision — UNSERVED ────────────────────────────────────────────────────
# Publishes the Ollama deployment outside the contract namespace so consumers
# do not find gpu/chat/vision and fall back cleanly (ember: PRESET with a
# cloud vision profile), while the entry stays introspectable for debugging.
# SERVED by the chat engine itself. Qwen3.6-35B-A3B takes text, image and
# video, and vLLM loads the vision tower with the checkpoint whether or not the
# alias is published — so the VRAM is spent either way and the alias is free.
# The warning that once put this at unserved/vision still holds in general: a
# TEXT model behind gpu/chat/vision passes a consumer's boot check and then
# 500s on the first image. Revert to the commented line if you point
# VLLM_MODEL at a text-only build.
# CONTRACT_VISION_ALIAS=unserved/vision
CONTRACT_VISION_ALIAS=gpu/chat/vision
CONTRACT_VISION_MODEL=openai/qwen3.6-35b-a3b
CONTRACT_VISION_API_BASE=http://vllm:8000/v1
ENABLE_OLLAMA=false

# Required even with ENABLE_LLAMACPP=false: compose interpolates every
# service's environment before profiles are applied, so an unset required
# variable refuses to render the file for a service that will never start.
LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=unused-on-this-box.gguf

# ── LiteLLM gateway ──────────────────────────────────────────────────────
# ⚠️  PORTS ARE REMAPPED off this stack's defaults, because these boxes also
# run the shared deepdarshak platform, which already holds 8080 (traefik
# dashboard), 6379 (falkordb), 9090 (prometheus) and 80/443 (traefik).
# Restoring the defaults on such a host makes the stack fail to bind.
LITELLM_PORT=8090
LITELLM_ADMIN_PORT=8091
LITELLM_BIND_ADDR=0.0.0.0
LITELLM_DROP_PARAMS=true
LITELLM_REQUEST_TIMEOUT=900
LITELLM_CACHE_TYPE=redis
LITELLM_REDIS_HOST=redis
LITELLM_REDIS_PORT=6379
# CHANGE THIS — placeholder.  openssl rand -hex 32
# Admin credential: it can read spend, mutate models and mint keys. Never hand
# it to a consumer; issue each one a virtual key scoped to the contract
# aliases (see the /key/generate recipe in .env.example).
# LITELLM_MASTER_KEY lives in .env, not in a profile (secret or host path).

REDIS_PORT=6380
PROMETHEUS_PORT=9490
GRAFANA_PORT=3400
NGINX_PORT=8081
NGINX_HTTPS_PORT=8443

# ── Storage ──────────────────────────────────────────────────────────────
# Point HF_HOME at a cache shared with anything else on the box that pulls the
# same weights, so 18 GB of Qwen is downloaded once rather than per stack.
# DATA_DIR lives in .env, not in a profile (secret or host path).
# VLLM_CACHE_DIR lives in .env, not in a profile (secret or host path).
# HF_HOME lives in .env, not in a profile (secret or host path).

NETWORK_NAME=gpu-inference-net
LOG_LEVEL=INFO
