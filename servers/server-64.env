# ddai4  —  100.117.227.64
# RTX PRO 4500 Blackwell, 32.6 GB, sm_120
#
# Activate with SERVER_PROFILE=64.
#
# Everything about this box — model, VRAM split, services, ports, role wiring —
# lives in the shared base below, because ddai1-ddai4 are the same machine.
# Only what is genuinely per-host belongs here.
EXTENDS=common-blackwell-32gb

SERVER_NAME=ddai4

# ── Per-host overrides ───────────────────────────────────────────────────
# 6379, not the base's 6380. ddai4 also runs the ember-ai stack, whose
# FalkorDB publishes 0.0.0.0:6380->6379 on this host; taking 6380 here would
# collide with it. 6379 is free on this box precisely because ember's own
# redis and langfuse redis are unpublished (container-internal only). The
# base's 6380 is correct on ddai1-ddai3, which run no FalkorDB.
REDIS_PORT=6379
