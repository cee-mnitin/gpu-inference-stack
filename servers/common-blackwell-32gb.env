# SHARED BASE — RTX PRO 4500 Blackwell, 32.6 GB, sm_120
#
# NOT SELECTABLE. This is not a server; it is what the ddai boxes have in
# common. A profile inherits it with `EXTENDS=common-blackwell-32gb`, and
# anything it sets afterwards wins (same last-wins rule compose applies
# between a profile and .env). Filename deliberately lacks the `server-`
# prefix so it never appears in the list of profiles you can select.
#
# WHY THIS EXISTS. ddai1-ddai4 are the same machine: same card, same model,
# same VRAM split, same ports. Held as four copies, changing the model would
# mean editing four files and missing one — the drift the profile system
# exists to prevent. Held here, it is one edit.
#
# Only genuinely per-host values belong in the deriving profile. Today that is
# SERVER_NAME alone, which is why `diff servers/server-61.env
# servers/server-63.env` is two lines. Anything else appearing in such a diff
# is drift worth explaining.
#
# Measured on ddai3, 2026-09-10/11, against ember's ingest pipeline: 0.445s
# median structured extraction at 100% field accuracy over 100 ground-truthed
# fields, 1.00s median summarization, 39.5s median KG extraction over 27
# documents. fp8 KV cache doubled the pool: 83,520 -> 173,856 tokens, 2.55x ->
# 5.31x concurrency at 32k.
#
# Those figures were taken against Qwen3-30B-A3B-Instruct-2507-AWQ-4bit, which
# this profile no longer serves. They are kept because they are what the VRAM
# split below was tuned against, not as a claim about the current model.
#
# Measured on ddai4, 2026-09-12, on Qwen3.6-35B-A3B-NVFP4 (this profile), all
# with thinking off, 256-token completions:
#     concurrency  1     176 tok/s
#     concurrency  8     816 tok/s aggregate  (102 per stream)
#     concurrency 23   1,666 tok/s aggregate  ( 72 per stream)
# 23 is GraphPipeline's fan-out per document, so that last row is the one that
# matters for KG extraction. Single-stream beats the 95-130 tok/s an RTX 5070
# Ti (same GB203 die, same 896 GB/s) was reported to do on this model.
#
# CUDA graphs capture normally here (19 PIECEWISE + 11 FULL); --enforce-eager
# is NOT needed. It would have been for a dense 27B in NVFP4, which is a
# concrete part of why the MoE was chosen for this card.

GPU_DEVICES=0
GPU_VRAM_TOTAL=32

# ── Services this box runs ───────────────────────────────────────────────
ENABLE_VLLM=true
ENABLE_VLLM2=false
ENABLE_VLLM3=false
ENABLE_LLAMACPP=false
ENABLE_INFINITY=true
ENABLE_EMBEDDINGS=false     # no UPSTREAM TEI tag for sm_120 — see below
ENABLE_OLLAMA=false

# ── Chat instance 1 → all three chat roles ───────────────────────────────
# A FLOOR now, not just a known-good pin. NVFP4 on sm_120 needs >= 0.28.0:
# below it FlashInfer does not select its XQA decode kernel on this compute
# capability and falls back silently, and the compose default v0.23.0 cannot
# load this checkpoint's architecture at all. Do not lower it while
# VLLM_MODEL names an NVFP4 build. Verify any bump actually starts here before
# rolling it out.
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
VLLM_PORT=8000
# LOOPBACK. Nothing off this box dials the engine directly — consumers use the
# gateway on LITELLM_PORT — so the direct port is bound to 127.0.0.1 and only
# LiteLLM (over the compose network) and local debugging can reach it.
#
# That matters: the engine has NO AUTH of its own. Exposed on 0.0.0.0 it is an
# open inference endpoint for anything that can route to this host, bypassing
# the gateway's keys, rate limits and spend tracking. Set 0.0.0.0 only if a
# consumer genuinely needs to skip the gateway, as crimson-llm2's legacy
# aliases do.
VLLM_BIND_ADDR=127.0.0.1
VLLM_ROUTER_BIND_ADDR=127.0.0.1
# NVFP4, not AWQ-4bit, and Qwen3.6 rather than the 2507 Instruct build.
#
# WHY THE MODEL. 35B total / ~3B active. Decode on this card is bandwidth-bound
# at 896 GB/s, so active parameters — not total — set the token rate, and a
# dense 27B of similar quality would move roughly 8x the weight bytes per
# token. The RTX 5070 Ti is the same GB203 die at the same bandwidth and
# measures 95-130 tok/s on this model; a DGX Spark at 273 GB/s manages 97.7.
# Agentic scores are what this box is for: SWE-bench Verified 73.4,
# TAU3-Bench 67.2, MCPMark 37.0, MCP-Atlas 62.8. Apache 2.0.
#
# WHY NVFP4 AND NOT AWQ. sm_120 has native FP4 tensor cores, so this is the
# quantization the silicon is built for. NVIDIA publishes the accuracy it
# retains against BF16 — MMLU-Pro 85.0 vs 85.6, GPQA-Diamond 84.8 vs 84.9 —
# whereas AWQ on this class of model has a documented reasoning regression.
# The checkpoint is mixed: GDN linear-attention layers stay FP8, the MoE
# experts go to FP4.
#
# WHY NOT Qwen3.8-27B, which scores higher. It is dense, so NVFP4 weights are
# ~24 GiB on one card; vLLM's single-32GB recipe then needs --enforce-eager
# (CUDA graphs off) and caps context at 32K, and Infinity no longer fits
# alongside it. It also defaults to xhigh reasoning — 22,276 reasoning tokens
# for 3,223 output tokens in one published run — which collides with the
# thinking-vs-JSON-grammar failure config/litellm/config.yaml documents.
# Revisit it if this box ever gets a second card.
VLLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
VLLM_MODEL_NAME=qwen3.6-35b-a3b
# 0.84 x 32.6 GB ~ 27.4 GB. Measured on this box: vLLM 26,126 MiB at 0.80,
# Infinity 3,782 MiB, and 950 MiB wasted by a leftover ollama container from a
# disabled profile — `make stop` clears that (it passes --remove-orphans) and
# the headroom goes to KV cache instead. Total then sits near 31.4 of 32.6 GB.
#
# Do NOT push this higher without re-measuring Infinity: it loads two 568M
# models lazily, so its footprint grows after first use, and vLLM preallocates
# and will not give any back.
# Do NOT lower toward the 0.65 default: KG extraction fans out ~23 concurrent
# chunk requests, so KV cache is the throughput limit for that workload. At
# 0.72 the cache thrashed at 99% with 18 queued and a 17k-char document took
# 875s; at 0.86 the queue stayed empty and the corpus ran ~2x faster.
#
# MEASURED AFTER THE MODEL CHANGE, 2026-09-12 on ddai4 — and the prediction
# that stood here was WRONG. The worry was that this checkpoint's larger
# weights (23.5 GB on disk vs the AWQ build's ~17 GiB) would take ~5 GiB out of
# the KV pool. They did not. At 0.84:
#     Available KV cache memory   2.93 GiB
#     GPU KV cache size           210,013 tokens
#     Maximum concurrency @32k    6.41x
# against 173,856 tokens / 5.31x recorded above for AWQ — 21% MORE KV, not
# less. The reason is architectural: Qwen3.6-35B-A3B is a hybrid Gated DeltaNet
# model, and its GDN layers carry a fixed-size recurrent state instead of a
# per-token KV cache. Only the true attention layers pay per token, so weight
# size is NOT a proxy for KV pressure here the way it was for a full-attention
# model. Weights and KV together sit at 29,907 MiB of 32,623 MiB with Infinity
# resident.
#
# vLLM notes at boot that CUDA-graph memory profiling makes 0.84 behave like
# 0.8152, and that 0.8648 would restore the pre-profiling effective KV size.
# Unnecessary while the pool is already ahead of the AWQ baseline; it is the
# lever if KG extraction ever queues again.
VLLM_GPU_MEMORY_UTILIZATION=0.84
VLLM_MAX_MODEL_LEN=32768
# 64, up from 32. KV cache is the binding constraint for KG extraction, not
# the sequence ceiling: GraphPipeline fans out ~23 concurrent chunk requests
# per document and chunks are far shorter than the 32k limit, so the pool
# holds many more of them than the "2.55x at 32k" figure vLLM prints at boot.
# 32 was leaving the engine idle while requests queued.
VLLM_MAX_NUM_SEQS=64
# FP8 KV cache — the single biggest lever on this card for this workload.
# Measured before: 83,520 tokens of KV at utilization 0.80. Halving the bytes
# per token roughly doubles that, which is exactly what a concurrency-bound
# job needs; Blackwell (sm_120) has native FP8 so the conversion is not
# emulated. Accuracy impact on KV is well below the noise of the 4-bit AWQ
# weights this box already serves.
# Set empty to go back to the model's own dtype.
VLLM_KV_CACHE_DTYPE=fp8
# qwen3_xml, not hermes. Qwen3.6's chat template emits
# `<tool_call><function=NAME><parameter=KEY>` — XML — where hermes expects a
# JSON object inside <tool_call>. The parsers are not interchangeable: hermes
# against this template yields no parsed tool calls at all, which a consumer
# sees as a model that simply never calls tools. hermes was correct for the
# Instruct-2507 build this profile used to serve.
VLLM_TOOL_CALL_PARSER=qwen3_xml
# SET NOW, empty before. The content:null failure recorded here was specific
# to Instruct-2507: a non-thinking model never emits a closing </think>, so the
# parser swallowed the whole answer into reasoning_content on 5/5 calls.
# Qwen3.6-35B-A3B is hybrid-thinking (its template takes enable_thinking and
# emits <think>), so the parser is now correct and is what separates reasoning
# from content instead of leaking raw <think> to consumers. Thinking is turned
# OFF per-role for bulk and fast by chat_template_kwargs in
# config/litellm/config.yaml; that layer is unaffected by this flag.
VLLM_REASONING_PARSER=qwen3
VLLM_EXPERT_PARALLEL=1
# REQUIRED FOR NVFP4 ON sm_120, both of them, per vLLM's own recipe for this
# model. --quantization names the ModelOpt FP4 loader; --block-size 128 is what
# FlashInfer's TRT-LLM attention kernels need on this compute capability.
VLLM_EXTRA_ARGS="--quantization modelopt_fp4 --block-size 128"
# Lets vLLM read FlashInfer's precompiled cubins directly. Without it
# FlashInfer only selects its XQA decode kernel on sm_120 from 0.28.0 onward
# and falls back otherwise — a silent throughput loss, not an error. Also why
# VLLM_IMAGE above may not go below v0.28.0 on this card.
VLLM_HAS_FLASHINFER_CUBIN=1

# ── Embed + rerank ───────────────────────────────────────────────────────
# Infinity rather than TEI. The PUBLISHED text-embeddings-inference images
# (turing / 89 / hopper / latest) carry no sm_120 kernels and crash-loop here
# with "Runtime compute cap 120 is not compatible with compile time compute
# cap 80". A LOCALLY BUILT TEI does work on Blackwell — crimson-llm2 runs
# `osint/tei:1.9.3-sm120` — so "TEI cannot run on sm_120" is too strong; the
# accurate claim is that no upstream tag does. Infinity remains the better fit
# here: no custom image to maintain, and it serves the embedder AND the
# reranker from one container — 346-3475 embeddings/sec at batch 32.
#
# CONCURRENCY CEILING: 8 in-flight embedding requests. Measured 2026-09-12 on
# ddai3 through the gateway: 1 concurrent = 1089 emb/s, 8 = 1353 emb/s, and 16
# = 872 emb/s WITH 7 OF 16 REQUESTS FAILING ("InfinityException - Server
# disconnected", surfaced to the caller as HTTP 500). Throughput has already
# plateaued by 8, so everything above it is pure loss: slower AND lossy.
# A bulk-embedding consumer should cap its parallelism at 8.
INFINITY_PORT=7997
INFINITY_CMD="v2 --model-id BAAI/bge-m3 --model-id BAAI/bge-reranker-v2-m3 --port 7997"

# ── Vision: SERVED, by the chat engine itself ────────────────────────────
# Was unserved because the model was text-only. Qwen3.6-35B-A3B accepts text,
# image and video, so the reason is gone and the alias costs no extra VRAM:
# vLLM loads the vision tower with the checkpoint whether or not the alias is
# published, so the memory is already spent either way.
#
# The warning that put it here still stands in general — publishing
# gpu/chat/vision behind a text model passes a consumer's boot check and then
# 500s on the first image — which is why this is only safe now that the served
# model genuinely takes images. Verify with one real image request before
# trusting it; revert to the two lines below if it does not hold.
#   CONTRACT_VISION_ALIAS=unserved/vision
#   CONTRACT_UNSERVED_ROLES="vision"
CONTRACT_VISION_ALIAS=gpu/chat/vision
CONTRACT_UNSERVED_ROLES=""
CONTRACT_VISION_MODEL=openai/qwen3.6-35b-a3b
CONTRACT_VISION_API_BASE=http://vllm:8000/v1

# ── Gateway ──────────────────────────────────────────────────────────────
# 8090, not 8080: platform-traefik holds 8080 on this host. The rest of the
# stack's default ports collide with the shared platform too (redis 6379 with
# falkordb, prometheus 9090), hence the shifts below.
LITELLM_PORT=8090
LITELLM_BIND_ADDR=0.0.0.0
LITELLM_REQUEST_TIMEOUT=900
REDIS_PORT=6380
PROMETHEUS_PORT=9490
GRAFANA_PORT=3400
NGINX_PORT=8081
NGINX_HTTPS_PORT=8443

# Required even with ENABLE_LLAMACPP=false: compose interpolates every
# service's environment before profiles apply, so an unset required variable
# refuses to render the file for a service that will never start.
LLAMACPP_MODELS_DIR=./data/llamacpp/models
LLAMACPP_MODEL_FILE=unused-on-this-box.gguf

# ── Delegating a role to a peer (uncomment to use) ───────────────────────
# Addresses come from the GPU_<octet>_* block in .env, which is identical on
# every box, so nothing here repeats an IP. The /v1 suffix is required for
# chat and vision bases; embed/rerank bases must NOT have it.
#
# CONTRACT_BULK_API_BASE=${GPU_85_URL}/v1
# CONTRACT_BULK_MODEL=openai/qwen3.6
# CONTRACT_BULK_API_KEY=${GPU_85_KEY}
#
# CONTRACT_VISION_ALIAS=gpu/chat/vision
# CONTRACT_VISION_API_BASE=${GPU_85_URL}/v1
# CONTRACT_VISION_MODEL=openai/qwen3.6
# CONTRACT_VISION_API_KEY=${GPU_85_KEY}
